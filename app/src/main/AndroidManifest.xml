<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Network interfaces are enumerated to show the LAN address of the lyric server. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- A manually entered lyric directory is read as a raw path: Android 6..10 needs this
         permission at runtime, Android 11..12 at least does not grant more than media access,
         and Android 13+ never grants it, hence the cap. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.netease.cloudmusic.iot" />
        <package android:name="com.tencent.qqmusic" />
        <package android:name="com.tencent.qqmusiccar" />
        <package android:name="com.kugou.android" />
        <package android:name="com.kugou.android.auto" />
        <package android:name="com.kugou.android.lite" />
        <package android:name="cn.kuwo.player" />
        <package android:name="cn.kuwo.kwmusiccar" />
        <package android:name="cn.kuwo.autolite" />
        <package android:name="com.shaiban.audioplayer.mplayer" />
        <package android:name="com.spotify.music" />
        <package android:name="com.luna.music" />
        <package android:name="com.luna.music.car" />
        <package android:name="com.ximalaya.ting.android" />
        <package android:name="com.ximalaya.ting.android.car" />
        <package android:name="com.dftc.media" />
        <package android:name="cmccwm.mobilemusic" />
        <package android:name="com.miui.player" />
        <package android:name="com.android.mediacenter" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.amazon.mp3" />
    </queries>

    <!-- requestLegacyExternalStorage is honoured on Android 10 devices even when targetSdk is 36,
         which is what lets a car head unit read .lrc next to the music by raw path; Android 11+
         ignores it and needs "所有文件访问" or a SAF directory instead. -->
    <application
        android:name=".WemewApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_compat"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@drawable/ic_launcher_compat"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="ScopedStorage">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WebSyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="LAN web lyrics sync server" />
        </service>

        <receiver
            android:name=".WebStartupReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".MusicNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
